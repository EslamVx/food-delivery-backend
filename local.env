# ==================== PROJECT INFO ====================
PROJECT_NAME=Fast Food Delivarty
NODE_ENV=development

# ==================== DATABASE CONFIGURATION ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=*******
DB_NAME=hotmeal
DB_CONNECTION_LIMIT=10

# ==================== SERVER CONFIGURATION ====================
PORT=5000
API_PREFIX=/api

# ==================== FRONTEND URLS (CORS) ====================
FRONTEND_URL=http://127.0.0.1:5500
FRONTEND_SIGNUP_PAGE=http://127.0.0.1:5500/food-delivery-frontend/signup.html
FRONTEND_LOGIN_PAGE=http://127.0.0.1:5500/food-delivery-frontend/login.html
FRONTEND_FORGOT_PASS_PAGE=http://127.0.0.1:5500/food-delivery-frontend/forgotpass.html

# ==================== AUTHENTICATION (JWT) ====================
JWT_SECRET=FastFoodDelivarty_Secret_Key_2024_*******
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==================== BCRYPT (Password Hashing) ====================
BCRYPT_SALT_ROUNDS=10

# ==================== UPLOADS ====================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/gif

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==================== SESSION (if needed) ====================
SESSION_SECRET=fast_food_session_secret_2024
SESSION_EXPIRES_IN=86400000  # 24 hours in milliseconds

# ==================== LOGGING ====================
LOG_LEVEL=debug
LOG_FILE=logs/app.log
